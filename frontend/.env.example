# Copy this file to .env and adjust for your setup.

# URL of the backend API. Point this at your deployed backend once you have
# one (e.g. https://api.anirudh.dev). Defaults to the local dev server.
VITE_API_URL=http://localhost:8000

# Optional. The homepage renders fallback content while this request waits,
# so 30 seconds gives a sleeping Render Free instance time to wake. Keep this
# public configuration free of secrets.
VITE_API_TIMEOUT_MS=30000
