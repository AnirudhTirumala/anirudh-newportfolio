# Copy this file to .env and fill in your own values before running the API.
# Never commit your real .env file.

# --- Auth -------------------------------------------------------------------
# REQUIRED when ENVIRONMENT=production - the app refuses to start without a
# real value (see app/config.py). In development, leaving this blank is
# fine: a random key is generated for you each run and printed to the logs.
# Generate a stable one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# The ONLY account that can log into /admin. Used once, the first time the
# app boots with an empty database, to create your admin user. Change it
# here before that first run - editing it afterwards has no effect unless
# you also clear the admin_users table.
# REQUIRED when ENVIRONMENT=production, for the same reason as SECRET_KEY -
# a portfolio site with a well-known default admin password is not safe to
# expose publicly. Left blank in development, a random one-time password is
# generated and printed to the console on first boot.
ADMIN_USERNAME=anirudh
ADMIN_PASSWORD=replace-with-a-strong-password

# --- Database -----------------------------------------------------------
# SQLite is the zero-config default - great for local dev and small
# deployments. For production, point this at a managed Postgres instance,
# e.g.: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./portfolio.db

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call this API. Add your deployed
# frontend URL here once you have one, e.g. https://anirudh.dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads -----------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# --- Lumpy Skin Disease Detection dashboard ---------------------------------
# Leave blank to run the dashboard in demo mode. Point it at a trained
# Ultralytics YOLO .pt file (and `pip install ultralytics`) to go live.
LUMPY_MODEL_PATH=
LUMPY_CONFIDENCE_THRESHOLD=0.35

# --- JanSeva Connect assistant -----------------------------------------
# Leave LLM_API_KEY blank to run the assistant in rule-based demo mode
# (still genuinely multilingual - it detects Hindi/Telugu/English). Add a
# key to make it live. Defaults target xAI's Grok API (OpenAI-compatible),
# matching what JanSeva Connect used - any OpenAI-compatible endpoint works.
# Check https://docs.x.ai/developers/models for the current model name.
LLM_API_KEY=
LLM_API_BASE=https://api.x.ai/v1
LLM_MODEL=grok-4.6

ENVIRONMENT=development
